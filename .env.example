# ==============================================================================
# Environment Configuration Template
# مشروع خط البيانات الهجين - المرحلة النهائية (Big Data - Phase 2)
# ==============================================================================

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017
DB_NAME=ecommerce_store

# Raw & Target Collections
RAW_COLLECTION=orders_raw
VALIDATED_COLLECTION=orders_validated
QUARANTINE_COLLECTION=orders_quarantine

# API Server Settings
API_HOST=127.0.0.1
API_PORT=8000

# File Router & Spark Settings
SMALL_FILE_THRESHOLD_MB=200
BATCH_SIZE=10000
SPARK_DRIVER_MEMORY=4g
